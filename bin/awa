#!/usr/bin/env bash
set -euo pipefail

resolve_root() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir=""
  local link_target=""
  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  cd "$source_dir/.." && pwd
}

ROOT="$(resolve_root)"
SKILL_FILE="$ROOT/skills/github-work-accountability/SKILL.md"
RECONCILER="$ROOT/skills/github-work-accountability/scripts/reconcile_project.py"
GH_ACCOUNT="$ROOT/skills/github-work-accountability/scripts/gh_account.py"

usage() {
  cat <<'EOF'
Agent Work Accountability skill-pack manager.

Usage:
  awa update [--check] [--no-guidance]
  awa version
  awa doctor [--user GITHUB_LOGIN]
  awa status [--repo OWNER/REPO] [--user GITHUB_LOGIN] [--host HOST] [--json|--quiet]
  awa help

Commands:
  update          Fast-forward the checkout and refresh global client integration
  update --check  Report whether the configured branch has a newer revision
  version         Print the installed skill version, revision, and source path
  doctor          Run the GitHub and installation diagnostic
  status          Detect existing managed work with one read-only REST search
EOF
}

skill_version() {
  python3 - "$SKILL_FILE" <<'PY'
from pathlib import Path
import re
import sys

text = Path(sys.argv[1]).read_text(encoding="utf-8")
match = re.search(r'^\s*version:\s*["\x27]?([^"\x27\s]+)', text, re.MULTILINE)
print(match.group(1) if match else "unknown")
PY
}

print_version() {
  local revision="unversioned"
  local qualification=""
  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    revision="$(git -C "$ROOT" rev-parse HEAD)"
    if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]]; then
      qualification=" (dirty)"
    else
      qualification=" (clean)"
    fi
  fi
  echo "awa $(skill_version)"
  echo "revision $revision$qualification"
  echo "source $ROOT"
}

acquire_update_lock() {
  local state_root="${XDG_STATE_HOME:-$HOME/.local/state}/agent-work-accountability"
  UPDATE_LOCK="$state_root/update.lock"
  mkdir -p "$state_root"
  if ! mkdir "$UPDATE_LOCK" 2>/dev/null; then
    echo "another awa update is already running: $UPDATE_LOCK" >&2
    exit 75
  fi
  trap 'rmdir "$UPDATE_LOCK" 2>/dev/null || true' EXIT HUP INT TERM
}

update_pack() {
  local check_only=0
  local install_guidance=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check_only=1; shift ;;
      --no-guidance) install_guidance=0; shift ;;
      *) echo "unknown update option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done
  command -v git >/dev/null 2>&1 || {
    echo "git is required for awa update" >&2
    exit 1
  }
  git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "awa update requires a Git-managed installation: $ROOT" >&2
    echo "rerun the one-line installer to replace this installation" >&2
    exit 1
  }

  local remote="${WORK_ACCOUNTABILITY_REMOTE:-origin}"
  local ref="${WORK_ACCOUNTABILITY_REF:-main}"
  local current=""
  local remote_url=""
  local remote_revision=""
  current="$(git -C "$ROOT" rev-parse HEAD)"
  remote_url="$(git -C "$ROOT" remote get-url "$remote")"
  remote_revision="$(git ls-remote "$remote_url" "refs/heads/$ref" | awk 'NR == 1 { print $1 }')"
  [[ -n "$remote_revision" ]] || {
    echo "cannot resolve $remote/$ref from $remote_url" >&2
    exit 1
  }

  if [[ $check_only -eq 1 ]]; then
    if [[ "$current" == "$remote_revision" ]]; then
      echo "awa $(skill_version) is current at $current"
    else
      echo "awa update available: $current -> $remote_revision"
    fi
    return
  fi

  [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]] || {
    echo "refusing to update a checkout with local changes: $ROOT" >&2
    echo "commit or remove the changes, then run awa update again" >&2
    exit 1
  }
  local branch=""
  branch="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD || true)"
  [[ "$branch" == "$ref" ]] || {
    echo "refusing to update branch ${branch:-detached HEAD}; expected $ref" >&2
    exit 1
  }

  acquire_update_lock
  git -C "$ROOT" fetch "$remote" "$ref"
  git -C "$ROOT" merge --ff-only FETCH_HEAD
  local install_arguments=(--source "$ROOT" --presets all)
  if [[ $install_guidance -eq 0 ]]; then
    install_arguments+=(--no-guidance)
  fi
  "$ROOT/install.sh" "${install_arguments[@]}"
  print_version
  echo "Restart running agent sessions to load the updated skill."
}

doctor() {
  [[ -x "$RECONCILER" ]] || {
    echo "missing reconciler: $RECONCILER" >&2
    exit 1
  }
  exec python3 "$RECONCILER" --diagnose "$@"
}

repository_from_remote() {
  local remote_url=""
  remote_url="$(git config --get remote.origin.url 2>/dev/null || true)"
  [[ -n "$remote_url" ]] || {
    echo "cannot detect a GitHub repository: pass --repo OWNER/REPO" >&2
    return 2
  }
  python3 - "$remote_url" <<'PY'
import re
import sys

remote = sys.argv[1].strip()
if remote.endswith(".git"):
    remote = remote[:-4]
patterns = (
    r"^(?:https?://|ssh://git@)([^/:]+)[/:]([^/]+/[^/]+)$",
    r"^git@([^:]+):([^/]+/[^/]+)$",
)
for pattern in patterns:
    match = re.match(pattern, remote)
    if match:
        print(match.group(2))
        raise SystemExit(0)
raise SystemExit(2)
PY
}

managed_status() {
  local repository=""
  local user=""
  local host="github.com"
  local output="human"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -ge 2 ]] || { echo "--repo requires OWNER/REPO" >&2; exit 2; }
        repository="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || { echo "--user requires a GitHub login" >&2; exit 2; }
        user="$2"
        shift 2
        ;;
      --host)
        [[ $# -ge 2 ]] || { echo "--host requires a hostname" >&2; exit 2; }
        host="$2"
        shift 2
        ;;
      --json) output="json"; shift ;;
      --quiet) output="quiet"; shift ;;
      *) echo "unknown status option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  if [[ -z "$repository" ]]; then
    repository="$(repository_from_remote)" || exit $?
  fi
  [[ "$repository" == */* && "$repository" != */*/* ]] || {
    echo "invalid repository; expected OWNER/REPO: $repository" >&2
    exit 2
  }
  command -v gh >/dev/null 2>&1 || {
    echo "gh is required for awa status" >&2
    exit 2
  }

  local query="repo:$repository is:issue in:body \"work-accountability:key\""
  local count=""
  if [[ -n "$user" ]]; then
    count="$(python3 "$GH_ACCOUNT" --user "$user" --host "$host" -- \
      api --hostname "$host" -X GET search/issues -f "q=$query" -f per_page=1 --jq .total_count)" || exit $?
  else
    count="$(gh api --hostname "$host" -X GET search/issues \
      -f "q=$query" -f per_page=1 --jq .total_count)" || exit $?
  fi
  [[ "$count" =~ ^[0-9]+$ ]] || {
    echo "GitHub returned an invalid managed-work count: $count" >&2
    exit 2
  }

  local managed="false"
  if [[ "$count" -gt 0 ]]; then
    managed="true"
  fi
  case "$output" in
    quiet) [[ "$managed" == "true" ]] ;;
    json)
      python3 - "$repository" "$host" "$managed" "$count" <<'PY'
import json
import sys

repository, host, managed, count = sys.argv[1:]
print(json.dumps({
    "schema": "agent-work-accountability/status-v1",
    "repository": repository,
    "host": host,
    "managed": managed == "true",
    "managed_issue_count": int(count),
    "transport": "github-rest-search",
}, sort_keys=True))
PY
      ;;
    human)
      if [[ "$managed" == "true" ]]; then
        echo "$repository has $count work-accountability managed issue(s)."
      else
        echo "$repository has no work-accountability managed issues."
      fi
      ;;
  esac
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    update) update_pack "$@" ;;
    version|--version|-V) [[ $# -eq 0 ]] || { usage >&2; exit 2; }; print_version ;;
    doctor) doctor "$@" ;;
    status) managed_status "$@" ;;
    help|--help|-h) [[ $# -eq 0 ]] || { usage >&2; exit 2; }; usage ;;
    *) echo "unknown command: $command" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
