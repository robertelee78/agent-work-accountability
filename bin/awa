#!/usr/bin/env bash
set -euo pipefail

resolve_root() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir=""
  local link_target=""
  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  cd "$source_dir/.." && pwd
}

ROOT="$(resolve_root)"
SKILL_FILE="$ROOT/skills/github-work-accountability/SKILL.md"
RECONCILER="$ROOT/skills/github-work-accountability/scripts/reconcile_project.py"
GH_ACCOUNT="$ROOT/skills/github-work-accountability/scripts/gh_account.py"

usage() {
  cat <<'EOF'
Agent Work Accountability skill-pack manager.

Usage:
  awa update [--check] [--no-guidance] [--verbose]
  awa version
  awa doctor [--user GITHUB_LOGIN] [--owner OWNER] [--host HOST] [--json]
  awa status [--repo OWNER/REPO] [--user GITHUB_LOGIN] [--host HOST] [--json|--quiet]
  awa help

Commands:
  update          Fast-forward the checkout and refresh global client integration
  update --check  Report whether the configured branch has a newer revision
  version         Print the installed skill version, revision, and source path
  doctor          Run the GitHub and installation diagnostic
  status          Detect existing managed work with one read-only REST search
EOF
}

skill_version() {
  python3 - "$SKILL_FILE" <<'PY'
from pathlib import Path
import re
import sys

text = Path(sys.argv[1]).read_text(encoding="utf-8")
match = re.search(r'^\s*version:\s*["\x27]?([^"\x27\s]+)', text, re.MULTILINE)
print(match.group(1) if match else "unknown")
PY
}

print_version() {
  local revision="unversioned"
  local qualification=""
  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    revision="$(git -C "$ROOT" rev-parse HEAD)"
    if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]]; then
      qualification=" (dirty)"
    else
      qualification=" (clean)"
    fi
  fi
  echo "awa $(skill_version)"
  echo "revision $revision$qualification"
  echo "source $ROOT"
}

acquire_update_lock() {
  local state_root="${XDG_STATE_HOME:-$HOME/.local/state}/agent-work-accountability"
  UPDATE_LOCK="$state_root/update.lock"
  mkdir -p "$state_root"
  if ! mkdir "$UPDATE_LOCK" 2>/dev/null; then
    echo "another awa update is already running: $UPDATE_LOCK" >&2
    exit 75
  fi
  trap 'rmdir "$UPDATE_LOCK" 2>/dev/null || true' EXIT HUP INT TERM
}

update_pack() {
  local check_only=0
  local install_guidance=1
  local verbose=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check_only=1; shift ;;
      --no-guidance) install_guidance=0; shift ;;
      --verbose|-v) verbose=1; shift ;;
      *) echo "unknown update option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done
  command -v git >/dev/null 2>&1 || {
    echo "git is required for awa update" >&2
    exit 1
  }
  git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "awa update requires a Git-managed installation: $ROOT" >&2
    echo "rerun the one-line installer to replace this installation" >&2
    exit 1
  }

  local git_directory=""
  local install_receipt=""
  git_directory="$(git -C "$ROOT" rev-parse --git-dir)"
  if [[ "$git_directory" != /* ]]; then
    git_directory="$ROOT/$git_directory"
  fi
  install_receipt="$git_directory/awa-install.json"
  [[ -f "$install_receipt" ]] || {
    echo "awa update does not modify a source-development checkout: $ROOT" >&2
    echo "install the managed channel, then use awa update:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/robertelee78/agent-work-accountability/main/install.sh | bash -s -- --replace" >&2
    exit 2
  }

  local receipt_values=""
  receipt_values="$(python3 - "$install_receipt" <<'PY'
import json
from pathlib import Path
import sys

path = Path(sys.argv[1])
try:
    payload = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as error:
    raise SystemExit(f"invalid managed-install receipt {path}: {error}")
if payload.get("schema") != "agent-work-accountability/managed-install-v1":
    raise SystemExit(f"invalid managed-install receipt schema in {path}")
for name in ("remote", "repository_url", "ref"):
    value = payload.get(name)
    if not isinstance(value, str) or not value or "\n" in value:
        raise SystemExit(f"invalid {name} in managed-install receipt {path}")
    print(value)
PY
)" || exit $?
  local remote=""
  local recorded_url=""
  local ref=""
  remote="$(printf '%s\n' "$receipt_values" | sed -n '1p')"
  recorded_url="$(printf '%s\n' "$receipt_values" | sed -n '2p')"
  ref="$(printf '%s\n' "$receipt_values" | sed -n '3p')"
  local current=""
  local current_version=""
  local remote_url=""
  local remote_revision=""
  current="$(git -C "$ROOT" rev-parse HEAD)"
  current_version="$(skill_version)"
  remote_url="$(git -C "$ROOT" remote get-url "$remote")"
  [[ "$remote_url" == "$recorded_url" ]] || {
    echo "refusing update: managed remote URL changed ($remote)" >&2
    echo "recorded: $recorded_url" >&2
    echo "actual:   $remote_url" >&2
    exit 2
  }
  remote_revision="$(git ls-remote "$remote_url" "refs/heads/$ref" | awk 'NR == 1 { print $1 }')"
  [[ -n "$remote_revision" ]] || {
    echo "cannot resolve $remote/$ref from $remote_url" >&2
    exit 1
  }

  if [[ $check_only -eq 1 ]]; then
    if [[ "$current" == "$remote_revision" ]]; then
      echo "awa $(skill_version) is current at $current"
    else
      echo "awa update available: $current -> $remote_revision"
    fi
    return
  fi

  [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]] || {
    echo "refusing to update a checkout with local changes: $ROOT" >&2
    echo "commit or remove the changes, then run awa update again" >&2
    exit 1
  }
  local branch=""
  branch="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD || true)"
  [[ "$branch" == "$ref" ]] || {
    echo "refusing to update branch ${branch:-detached HEAD}; expected $ref" >&2
    exit 1
  }

  acquire_update_lock
  local fetch_output=""
  local merge_output=""
  local install_output=""
  if ! fetch_output="$(git -C "$ROOT" fetch "$remote" "$ref" 2>&1)"; then
    printf '%s\n' "$fetch_output" >&2
    exit 1
  fi
  if ! merge_output="$(git -C "$ROOT" merge --ff-only FETCH_HEAD 2>&1)"; then
    printf '%s\n' "$merge_output" >&2
    exit 1
  fi
  local install_arguments=(--source "$ROOT" --presets all)
  if [[ $install_guidance -eq 0 ]]; then
    install_arguments+=(--no-guidance)
  fi
  if ! install_output="$("$ROOT/install.sh" "${install_arguments[@]}" 2>&1)"; then
    printf '%s\n' "$install_output" >&2
    exit 1
  fi

  if [[ $verbose -eq 1 ]]; then
    [[ -z "$fetch_output" ]] || printf '%s\n' "$fetch_output"
    [[ -z "$merge_output" ]] || printf '%s\n' "$merge_output"
    [[ -z "$install_output" ]] || printf '%s\n' "$install_output"
  fi

  local updated_revision=""
  local updated_version=""
  local integration_changed=0
  updated_revision="$(git -C "$ROOT" rev-parse HEAD)"
  updated_version="$(skill_version)"
  if grep -Eq '^(install|backup)[[:space:]]' <<< "$install_output"; then
    integration_changed=1
  fi

  if [[ "$current" == "$updated_revision" && $integration_changed -eq 0 ]]; then
    echo "awa $updated_version is current (${updated_revision:0:12})."
  elif [[ "$current" != "$updated_revision" ]]; then
    echo "Updated awa $current_version -> $updated_version (${current:0:12} -> ${updated_revision:0:12})."
    echo "Restart running agent sessions to load the update."
  else
    echo "awa $updated_version is current (${updated_revision:0:12}); refreshed client integration."
    echo "Restart running agent sessions to load the refreshed integration."
  fi
}

doctor() {
  [[ -x "$RECONCILER" ]] || {
    echo "missing reconciler: $RECONCILER" >&2
    exit 1
  }

  local user=""
  local owner=""
  local host="github.com"
  local json_output=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        [[ $# -ge 2 ]] || { echo "--user requires a GitHub login" >&2; exit 2; }
        user="$2"
        shift 2
        ;;
      --owner)
        [[ $# -ge 2 ]] || { echo "--owner requires a GitHub owner" >&2; exit 2; }
        owner="$2"
        shift 2
        ;;
      --host)
        [[ $# -ge 2 ]] || { echo "--host requires a hostname" >&2; exit 2; }
        host="$2"
        shift 2
        ;;
      --json) json_output=1; shift ;;
      *) echo "unknown doctor option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  local diagnose_arguments=(--diagnose --host "$host")
  if [[ -n "$user" ]]; then
    diagnose_arguments+=(--user "$user")
  fi
  local diagnosis=""
  if ! diagnosis="$(python3 "$RECONCILER" "${diagnose_arguments[@]}" 2>&1)"; then
    printf '%s\n' "$diagnosis" >&2
    exit 2
  fi

  local repository=""
  local owner_source="argument"
  if [[ -z "$owner" ]]; then
    repository="$(repository_from_remote 2>/dev/null || true)"
    if [[ -n "$repository" ]]; then
      owner="${repository%%/*}"
      owner_source="repository"
    else
      owner_source="none"
    fi
  fi

  local auth_output=""
  # The diagnosis above already proved the selected token resolves to the
  # requested login. `gh auth status` is only a best-effort classic OAuth
  # scope probe: older gh versions lack newer filtering flags, and an invalid
  # unrelated stored account can make the unfiltered command exit nonzero.
  local auth_ok=1
  local projects_output=""
  local projects_ok=0
  local projects_checked=0
  if [[ -n "$user" ]]; then
    auth_output="$(python3 "$GH_ACCOUNT" --user "$user" --host "$host" -- \
      auth status --hostname "$host" 2>&1 || true)"
    if [[ -n "$owner" ]]; then
      projects_checked=1
      if projects_output="$(python3 "$GH_ACCOUNT" --user "$user" --host "$host" -- \
        project list --owner "$owner" --limit 1 --format json 2>&1)"; then
        projects_ok=1
      fi
    fi
  else
    auth_output="$(gh auth status --hostname "$host" 2>&1 || true)"
    if [[ -n "$owner" ]]; then
      projects_checked=1
      if projects_output="$(gh project list --owner "$owner" --limit 1 --format json 2>&1)"; then
        projects_ok=1
      fi
    fi
  fi

  local format="human"
  if [[ $json_output -eq 1 ]]; then
    format="json"
  fi
  python3 - "$diagnosis" "$owner" "$owner_source" "$auth_ok" "$projects_checked" \
    "$projects_ok" "$auth_output" "$projects_output" "$format" "$user" <<'PY'
import json
import re
import sys

diagnosis = json.loads(sys.argv[1])
owner = sys.argv[2]
owner_source = sys.argv[3]
auth_ok = sys.argv[4] == "1"
projects_checked = sys.argv[5] == "1"
projects_ok = sys.argv[6] == "1"
auth_output = sys.argv[7]
projects_output = sys.argv[8]
output_format = sys.argv[9]
requested_user = sys.argv[10]

scope_match = re.search(r"Token scopes:\s*(.*)", auth_output)
scopes = sorted(set(re.findall(r"'([^']+)'", scope_match.group(1)))) if scope_match else []
project_scope = "project" in scopes if scopes else None
projects_error = projects_output.casefold()
missing_project_scope = (
    projects_checked
    and not projects_ok
    and "missing required scope" in projects_error
    and ("read:project" in projects_error or "project" in projects_error)
)
rate = diagnosis.get("rate") or {}
remaining = int(rate.get("remaining") or 0)
limit = int(rate.get("limit") or 0)
budget_ok = remaining >= 100
source_ok = diagnosis.get("git_dirty") is not True
scope_ok = project_scope is not False
owner_access_ok = projects_ok if projects_checked else True
ready = all((auth_ok, owner_access_ok, budget_ok, source_ok, scope_ok))

checks = {
    "authentication": {"ok": auth_ok, "login": diagnosis.get("login")},
    "graphql_budget": {
        "ok": budget_ok,
        "remaining": remaining,
        "limit": limit,
        "reset": rate.get("reset"),
    },
    "installation": {
        "ok": source_ok,
        "skill_version": diagnosis.get("skill_version"),
        "revision": diagnosis.get("git_revision"),
        "dirty": diagnosis.get("git_dirty"),
    },
    "project_scope": {"ok": project_scope, "scopes": scopes},
    "project_owner_access": {
        "checked": projects_checked,
        "ok": projects_ok if projects_checked else None,
        "owner": owner or None,
        "source": owner_source,
    },
}
failures = []
remediation = []
if not auth_ok:
    failures.append(auth_output.strip() or "GitHub authentication check failed")
if project_scope is False or missing_project_scope:
    login = diagnosis.get("login")
    host = diagnosis.get("host")
    failures.append(f"token for {login} lacks the write-capable project scope")
    if requested_user:
        remediation.append(f"gh auth switch --hostname {host} --user {login}")
    remediation.append(f"gh auth refresh --hostname {host} --scopes project")
    remediation.append(
        "On a headless host, open https://github.com/login/device in another browser "
        "and enter the one-time code printed by gh."
    )
if projects_checked and not projects_ok and not missing_project_scope:
    failures.append(projects_output.strip() or f"cannot list Projects for {owner}")
if not budget_ok:
    failures.append(f"GraphQL budget is {remaining}/{limit}; wait until reset {rate.get('reset')}")
if not source_ok:
    failures.append("installed skill-pack checkout has local changes")

payload = {
    "schema": "agent-work-accountability/doctor-v1",
    "ready": ready,
    "checks": checks,
    "failures": failures,
    "remediation": remediation,
    "diagnosis": diagnosis,
}
if output_format == "json":
    print(json.dumps(payload, sort_keys=True))
else:
    state = "ready" if ready else "not ready"
    revision = (diagnosis.get("git_revision") or "unversioned")[:12]
    dirty = "dirty" if diagnosis.get("git_dirty") else "clean"
    print(f"awa doctor: {state}")
    print(f"  skill {diagnosis.get('skill_version')} ({revision}, {dirty})")
    print(f"  GitHub {diagnosis.get('login')} @ {diagnosis.get('host')}")
    scope_text = "project scope verified" if project_scope else (
        "scope not reported" if project_scope is None else "project scope missing"
    )
    if projects_checked:
        access_text = "access verified" if projects_ok else "access failed"
        print(f"  Projects {owner}: {scope_text}, {access_text}")
    else:
        print(f"  Projects: {scope_text}; owner access not checked")
        print("  Target: run inside a GitHub repository or pass --owner OWNER")
    print(f"  GraphQL {remaining}/{limit} remaining")
    for failure in failures:
        print(f"  FAIL: {failure}")
    for step in remediation:
        print(f"  FIX: {step}")
raise SystemExit(0 if ready else 2)
PY
}

repository_from_remote() {
  local remote_url=""
  remote_url="$(git config --get remote.origin.url 2>/dev/null || true)"
  [[ -n "$remote_url" ]] || {
    echo "cannot detect a GitHub repository: pass --repo OWNER/REPO" >&2
    return 2
  }
  python3 - "$remote_url" <<'PY'
import re
import sys

remote = sys.argv[1].strip()
if remote.endswith(".git"):
    remote = remote[:-4]
patterns = (
    r"^(?:https?://|ssh://git@)([^/:]+)[/:]([^/]+/[^/]+)$",
    r"^git@([^:]+):([^/]+/[^/]+)$",
)
for pattern in patterns:
    match = re.match(pattern, remote)
    if match:
        print(match.group(2))
        raise SystemExit(0)
raise SystemExit(2)
PY
}

managed_status() {
  local repository=""
  local user=""
  local host="github.com"
  local output="human"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -ge 2 ]] || { echo "--repo requires OWNER/REPO" >&2; exit 2; }
        repository="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || { echo "--user requires a GitHub login" >&2; exit 2; }
        user="$2"
        shift 2
        ;;
      --host)
        [[ $# -ge 2 ]] || { echo "--host requires a hostname" >&2; exit 2; }
        host="$2"
        shift 2
        ;;
      --json) output="json"; shift ;;
      --quiet) output="quiet"; shift ;;
      *) echo "unknown status option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  if [[ -z "$repository" ]]; then
    repository="$(repository_from_remote)" || exit $?
  fi
  [[ "$repository" == */* && "$repository" != */*/* ]] || {
    echo "invalid repository; expected OWNER/REPO: $repository" >&2
    exit 2
  }
  command -v gh >/dev/null 2>&1 || {
    echo "gh is required for awa status" >&2
    exit 2
  }

  local query="repo:$repository is:issue in:body \"work-accountability:key\""
  local count=""
  if [[ -n "$user" ]]; then
    count="$(python3 "$GH_ACCOUNT" --user "$user" --host "$host" -- \
      api --hostname "$host" -X GET search/issues -f "q=$query" -f per_page=1 --jq .total_count)" || exit $?
  else
    count="$(gh api --hostname "$host" -X GET search/issues \
      -f "q=$query" -f per_page=1 --jq .total_count)" || exit $?
  fi
  [[ "$count" =~ ^[0-9]+$ ]] || {
    echo "GitHub returned an invalid managed-work count: $count" >&2
    exit 2
  }

  local managed="false"
  if [[ "$count" -gt 0 ]]; then
    managed="true"
  fi
  case "$output" in
    quiet) [[ "$managed" == "true" ]] ;;
    json)
      python3 - "$repository" "$host" "$managed" "$count" <<'PY'
import json
import sys

repository, host, managed, count = sys.argv[1:]
print(json.dumps({
    "schema": "agent-work-accountability/status-v1",
    "repository": repository,
    "host": host,
    "managed": managed == "true",
    "managed_issue_count": int(count),
    "transport": "github-rest-search",
}, sort_keys=True))
PY
      ;;
    human)
      if [[ "$managed" == "true" ]]; then
        echo "$repository has $count work-accountability managed issue(s)."
      else
        echo "$repository has no work-accountability managed issues."
      fi
      ;;
  esac
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    update) update_pack "$@" ;;
    version|--version|-V) [[ $# -eq 0 ]] || { usage >&2; exit 2; }; print_version ;;
    doctor) doctor "$@" ;;
    status) managed_status "$@" ;;
    help|--help|-h) [[ $# -eq 0 ]] || { usage >&2; exit 2; }; usage ;;
    *) echo "unknown command: $command" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
